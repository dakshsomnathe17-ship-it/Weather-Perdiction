# Database
DATABASE_URL=sqlite+aiosqlite:///./weather.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather_ai

# Redis
REDIS_URL=redis://localhost:6379

# Weather Providers
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHERAPI_KEY=
# Place search (copy this file to backend/.env)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT="WeatherPrediction/1.0 (https://github.com/dakshsomnathe17-ship-it/Weather-Perdiction)"
NOMINATIM_CACHE_PATH=./nominatim-cache.sqlite3

# ML
ML_MODEL_DIR=./ml_models

# Chat / LLM
LLM_PROVIDER=rule_based
LLM_API_KEY=

# App
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
