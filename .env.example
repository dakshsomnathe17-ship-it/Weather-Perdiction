# Database
DATABASE_URL=sqlite+aiosqlite:///./weather.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather_ai

# Redis
REDIS_URL=redis://localhost:6379

# Weather Providers
WEATHER_PROVIDER=open_meteo
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHERAPI_KEY=
NOAA_API_KEY=

# Google Maps (satellite Earth texture in the 3D globe)
# Requires Maps Static API enabled on your Google Cloud project
VITE_GOOGLE_MAPS_API_KEY=

# ML
ML_MODEL_DIR=./ml_models

# Chat / LLM
LLM_PROVIDER=rule_based
LLM_API_KEY=

# App
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]
