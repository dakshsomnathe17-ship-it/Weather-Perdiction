# Natural Earth works immediately; leave this empty until Esri is configured.
# Use a browser-safe ArcGIS token restricted to your application's origins.
VITE_ARCGIS_ACCESS_TOKEN=
# Optional compatible licensed ArcGIS MapServer endpoints.
VITE_ESRI_IMAGERY_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/World_Imagery/MapServer
VITE_ESRI_LABELS_URL=https://ibasemaps-api.arcgis.com/arcgis/rest/services/Reference/World_Boundaries_and_Places/MapServer
